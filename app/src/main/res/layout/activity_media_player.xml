<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:keepScreenOn="true">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layout_player_header"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#20000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_player_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Song title.mp3" />

            <TextView
                android:id="@+id/tv_player_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                tools:text="1 of 12 files" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_player_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_share"
            android:src="@drawable/ic_action_share"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Center Display Area (VideoView or Audio Illustration) -->
    <FrameLayout
        android:id="@+id/layout_media_viewport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_player_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_player_header">

        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_audio_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/iv_audio_art"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/ic_cat_audio"
                android:backgroundTint="#263238"
                android:contentDescription="@string/category_audio"
                android:padding="32dp"
                android:src="@drawable/ic_cat_audio"
                app:tint="#4CAF50" />

            <TextView
                android:id="@+id/tv_audio_artist_album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="#90A4AE"
                android:textSize="14sp"
                tools:text="Artist / Album Info" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Controls Container -->
    <LinearLayout
        android:id="@+id/layout_player_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#20000000"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Time & SeekBar row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:text="00:00"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_bar_player"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressBackgroundTint="#546E7A"
                android:progressTint="#4CAF50"
                android:thumbTint="#81C784" />

            <TextView
                android:id="@+id/tv_total_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:text="00:00"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Buttons Row: Previous, Rewind, Play/Pause, Forward, Next -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Previous button -->
            <ImageButton
                android:id="@+id/btn_player_previous"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_previous_track"
                android:src="@drawable/ic_skip_previous"
                app:tint="#FFFFFF" />

            <!-- Rewind 10 seconds button -->
            <ImageButton
                android:id="@+id/btn_player_rewind"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_rewind_10s"
                android:src="@drawable/ic_fast_rewind"
                app:tint="#FFFFFF" />

            <!-- Play / Pause button -->
            <ImageButton
                android:id="@+id/btn_player_play_pause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="#4CAF50"
                android:contentDescription="@string/btn_play"
                android:src="@drawable/ic_action_play"
                app:tint="#FFFFFF" />

            <!-- Fast Forward 10 seconds button -->
            <ImageButton
                android:id="@+id/btn_player_fast_forward"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_forward_10s"
                android:src="@drawable/ic_fast_forward"
                app:tint="#FFFFFF" />

            <!-- Next button -->
            <ImageButton
                android:id="@+id/btn_player_next"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_next_track"
                android:src="@drawable/ic_skip_next"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
