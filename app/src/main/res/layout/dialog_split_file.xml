<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Split Method Spinner -->
        <TextView
            android:id="@+id/tv_label_split_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_split_method"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_split_method"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/label_split_method"
            android:layout_marginBottom="16dp" />

        <!-- Split Value Input -->
        <TextView
            android:id="@+id/tv_label_split_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_split_duration"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_split_value"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:inputType="number"
            android:hint="60"
            android:contentDescription="@string/label_split_duration"
            android:layout_marginBottom="16dp" />

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progress_split"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</ScrollView>
