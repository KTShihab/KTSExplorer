<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_batch_rename_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_batch_rename_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/tv_batch_rename_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            tools:text="5 files selected" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Choose Renaming Position / Mode:"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Position / Mode RadioGroup -->
        <RadioGroup
            android:id="@+id/rg_rename_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_mode_beginning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/rename_mode_beginning"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rb_mode_end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/rename_mode_end"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rb_mode_center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/rename_mode_center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rb_mode_pattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/rename_mode_pattern"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />
        </RadioGroup>

        <!-- CONTAINER 1: Beginning (Prefix) Options -->
        <LinearLayout
            android:id="@+id/panel_mode_beginning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_prefix_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_prefix_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/cb_prefix_numbering"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/label_include_numbering" />

            <LinearLayout
                android:id="@+id/layout_prefix_num_opts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_start_number"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_prefix_start_num"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="1"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONTAINER 2: End (Suffix) Options -->
        <LinearLayout
            android:id="@+id/panel_mode_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_suffix_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_suffix_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/cb_suffix_numbering"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/label_include_numbering" />

            <LinearLayout
                android:id="@+id/layout_suffix_num_opts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_start_number"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_suffix_start_num"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="1"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONTAINER 3: Center (Find & Replace) Options -->
        <LinearLayout
            android:id="@+id/panel_mode_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_find_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_find_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_replace_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_replace_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/cb_case_sensitive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/label_case_sensitive" />
        </LinearLayout>

        <!-- CONTAINER 4: Pattern (New Name + Sequential Numbering) Options -->
        <LinearLayout
            android:id="@+id/panel_mode_pattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_base_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_base_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hint_start_number"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_pattern_start_num"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="1"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_numbering_digits"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinner_digits"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_separator"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinner_separator"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- General Option: Keep Extension -->
        <CheckBox
            android:id="@+id/cb_keep_extension"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:text="@string/label_keep_extension" />

        <!-- Live Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_rename_preview"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_preview_line1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    tools:text="sample1.mp3 → Travel_sample1.mp3" />

                <TextView
                    android:id="@+id/tv_preview_line2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    tools:text="sample2.mp3 → Travel_sample2.mp3" />

                <TextView
                    android:id="@+id/tv_preview_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="... and 3 more files" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dialog Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_rename"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_rename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_rename" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
