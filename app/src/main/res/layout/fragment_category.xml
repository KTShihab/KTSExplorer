<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Categories Overview Screen (The 6 Cards) -->
    <LinearLayout
        android:id="@+id/layout_categories_overview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/colorPrimary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btn_drawer_category"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_open_drawer"
                android:src="@drawable/ic_menu"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:accessibilityHeading="true"
                android:text="@string/nav_category"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_categories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"
            android:contentDescription="@string/category_list_label" />

    </LinearLayout>

    <!-- Category Detail (Folders & Files List) Screen -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_category_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="?android:attr/windowBackground">

        <!-- Normal Detail Header Bar -->
        <LinearLayout
            android:id="@+id/category_detail_header"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="?attr/colorPrimary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btn_category_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_back_to_categories"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_category_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Audio Files" />

            <ImageButton
                android:id="@+id/btn_category_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_search"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btn_category_sort"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_sort"
                android:src="@drawable/ic_sort"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btn_category_refresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_refresh"
                android:src="@drawable/ic_refresh"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Live Search Bar Header for Category Detail -->
        <LinearLayout
            android:id="@+id/category_search_layout"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="?attr/colorPrimary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btn_category_close_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_close_search"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <EditText
                android:id="@+id/et_category_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textColorHint="#B3FFFFFF"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btn_category_clear_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_clear_search"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />

        </LinearLayout>


        <!-- Apps Category Mode Tabs (APK Files vs Installed Apps) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout_apps"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:visibility="gone"
            android:background="?attr/colorPrimary"
            app:tabTextColor="#B3FFFFFF"
            app:tabSelectedTextColor="@color/white"
            app:tabIndicatorColor="@color/white"
            app:tabIndicatorHeight="3dp"
            app:layout_constraintTop_toBottomOf="@id/category_detail_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_category_files"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/files_recycler_label"
            app:layout_constraintTop_toBottomOf="@id/tab_layout_apps"
            app:layout_constraintBottom_toTopOf="@id/category_selection_bottom_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_file" />

        <TextView
            android:id="@+id/tv_category_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/category_no_files"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/category_detail_header"
            app:layout_constraintBottom_toTopOf="@id/category_selection_bottom_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ProgressBar
            android:id="@+id/progress_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/loading_files"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/category_detail_header"
            app:layout_constraintBottom_toTopOf="@id/category_selection_bottom_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Selection Mode Bottom Action Panel for Category Detail (Directly above Bottom Navigation Tabs) -->
        <LinearLayout
            android:id="@+id/category_selection_bottom_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackgroundFloating"
            android:elevation="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Upper Row: Close, Selection Count, Select All -->
            <LinearLayout
                android:id="@+id/category_selection_header_layout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#0D47A1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageButton
                    android:id="@+id/btn_category_close_selection"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_exit_selection"
                    android:src="@drawable/ic_close"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tv_category_selection_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="1 selected" />

                <ImageButton
                    android:id="@+id/btn_category_select_all"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_select_all"
                    android:src="@drawable/ic_select_all"
                    app:tint="@color/white" />

            </LinearLayout>

            <!-- Lower Row: Actions (Share, Cut, Copy, Delete, Favorite) -->
            <LinearLayout
                android:id="@+id/category_selection_actions_bar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:baselineAligned="false">

            <!-- Share Action -->
            <LinearLayout
                android:id="@+id/btn_category_share_selection"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/action_share">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_action_share"
                    app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_share"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Cut Action -->
            <LinearLayout
                android:id="@+id/btn_category_cut_selection"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/btn_cut_selected">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_action_cut"
                    app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_cut"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Copy Action -->
            <LinearLayout
                android:id="@+id/btn_category_copy_selection"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/btn_copy_selected">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_action_copy"
                    app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_copy"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Delete Action -->
            <LinearLayout
                android:id="@+id/btn_category_delete_selection"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/action_delete">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_action_delete"
                    app:tint="#D32F2F"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_delete"
                    android:textSize="11sp"
                    android:textColor="#D32F2F"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Favorite Action -->
            <LinearLayout
                android:id="@+id/btn_category_favorite_selection"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/btn_favorite_selected">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_action_favorite"
                    app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_favorite"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

        </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
